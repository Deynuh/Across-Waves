--- !u!114 &870425111
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 870425110}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 41d0eed8772294ceea22cbebcb189407, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nodes:
  - nodeID: gameOver
    dialogueText: That was pretty cute! Thanks for playing with me.
    choices:
    - choiceText: That was fun!
      targetNodeID: eloItWas
    - choiceText: That was meh
      targetNodeID: eloAgree
    nextNodeID: 
  - nodeID: eloAgree
    dialogueText: Haha you're just upset I drew better than you!
    choices:
    - choiceText: As if!!
      targetNodeID: eloLaugh
    - choiceText: I want a rematch!
      targetNodeID: eloCant
    nextNodeID: 
  - nodeID: eloLaugh
    dialogueText: I'm kidding, love, you're so cute. Let's find more games to play
      tomorrow!
    choices:
    - choiceText: Let's!
      targetNodeID: eloGoodbye
    - choiceText: I choose what we play tomorrow!
      targetNodeID: eloFine
    nextNodeID: 
  - nodeID: eloCant
    dialogueText: Hahaha you're on! Let's do that tomorrow?
    choices:
    - choiceText: Yeah!
      targetNodeID: eloGoodbye
    - choiceText: You're going down.
      targetNodeID: eloScared
    nextNodeID: 
  - nodeID: eloFine
    dialogueText: Yes, love, we can playwhatever game you want tomorrow.
    choices:
    - choiceText: Yay!
      targetNodeID: eloGoodbye
    - choiceText: You're going down.
      targetNodeID: eloScared
    nextNodeID: 
  - nodeID: eloScared
    dialogueText: You're adorable when you're competitive. I wish we had more time
      to talk today.
    choices:
    - choiceText: Me too..
      targetNodeID: eloGoodbye
    - choiceText: It's okay we'll talk more tomorrow!
      targetNodeID: eloGoodbye
    nextNodeID: 
  - nodeID: eloGoodbye
    dialogueText: Okay, I really have to go now. Sorry I didn't have much time to
      talk today, love. See you tomorrow?
    choices:
    - choiceText: It's alright. See you tomorrow. I love you!
      targetNodeID: goodbye
    - choiceText: I miss you already.. I love you!
      targetNodeID: goodbye
    nextNodeID: 
  - nodeID: goodbye
    dialogueText: I love you too, bye for now!
    choices: []
    nextNodeID: 
  - nodeID: eloItWas
    dialogueText: It really was. Let's play more tomorrow?
    choices:
    - choiceText: Let's!
      targetNodeID: eloGoodbye
    - choiceText: I choose what we play tomorrow!
      targetNodeID: eloFine
    nextNodeID: 
